# ==============================================================================
# PGCET Student Portal - Backend Environment Variables
# ==============================================================================

# Project Meta
PROJECT_NAME="PGCET Student Portal API"
VERSION="1.0.0"
ENVIRONMENT=production  # "development" | "production"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pgcet_portal

# JWT Security
# Generate a secure 32+ byte string (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Setup & Protection
ADMIN_SIGNUP_SECRET=optional_secret_for_automated_admin_provisioning
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@pgcet.in"
ADMIN_PASSWORD="ChangeThisPassword123!"

# CORS Configuration
# Comma-separated list of allowed frontend origins (NO trailing slashes)
# In production, replace with your deployed Vercel domain and custom domain
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://pgcet-portal.vercel.app

# File Storage Configuration
# Options: "local" (default for dev) or "cloudinary" (recommended for Render/production)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Cloudinary Storage Credentials (required when STORAGE_TYPE=cloudinary)
# You can set CLOUDINARY_URL or individual credentials
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting (slowapi limits)
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOOKUP=20/minute
